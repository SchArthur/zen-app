# --- Base de données (docker compose) ---
POSTGRES_USER=pfr
POSTGRES_PASSWORD=pfr
POSTGRES_DB=pfr
POSTGRES_PORT=5432

DATABASE_URL="postgresql://pfr:pfr@localhost:5432/pfr"

# --- Sessions (nuxt-auth-utils) ---
# 32 caractères minimum : openssl rand -hex 16
NUXT_SESSION_PASSWORD=

# --- URL publique ---
# Base des liens de confirmation envoyés par email. En production, même domaine
# que NUXT_PUBLIC_SITE_URL.
NUXT_PUBLIC_APP_URL=http://localhost:3000

# --- Référencement ---
# Adresse canonique du site : elle sert au plan de site, aux liens canoniques et
# aux métadonnées de partage, qui ne peuvent pas être relatifs. Vide en local, la
# valeur par défaut de nuxt.config.ts suffit.
NUXT_PUBLIC_SITE_URL=
# Secret de signature des images de partage. Sans lui, il est régénéré à chaque
# compilation et invalide les adresses d'images déjà partagées.
# npx nuxt-og-image generate-secret
NUXT_OG_IMAGE_SECRET=

# --- Mesure d'audience ---
# Les deux sont nécessaires : sans hôte, aucun script n'est chargé et rien n'est
# ouvert dans la politique de sécurité de contenu ; sans domaine, le script ne
# saurait pas à quel site rattacher les visites. Le chargement reste en outre
# conditionné au consentement de la personne (CU-04) — c'est l'exigence F12.
# ⚠️ NUXT_PUBLIC_ANALYTICS_HOST doit être présente **à la compilation** : c'est
# elle qui ouvre l'origine dans la politique de sécurité de contenu, laquelle est
# figée dans le paquet servi. Posée seulement à l'exécution, le script se
# chargerait et ses appels seraient bloqués par le navigateur.
NUXT_PUBLIC_ANALYTICS_HOST=
NUXT_PUBLIC_ANALYTICS_DOMAIN=

# --- Envoi des emails ---
# En développement : Mailpit (docker compose), interface web sur http://localhost:8025
# En production : renseigner les identifiants SMTP du fournisseur.
NUXT_MAIL_HOST=localhost
NUXT_MAIL_PORT=1025
NUXT_MAIL_SECURE=false
NUXT_MAIL_USER=
NUXT_MAIL_PASSWORD=
NUXT_MAIL_FROM="ZenTime <bonjour@zentime.fr>"

# Ports exposés par le conteneur Mailpit
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
